<ui:FluentWindow x:Class="SessionDeck.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="470" Height="720" MinWidth="420" MinHeight="420"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Segoe UI Variable, Segoe UI"
                 FontSize="14">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Settings" Height="36"/>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
      <StackPanel Margin="18,14">
        <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Dark theme" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
          <ui:ToggleSwitch x:Name="ThemeToggle" Grid.Column="1"/>
        </Grid>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Show in taskbar" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="Turn off to live in the tray only." FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>
          </StackPanel>
          <ui:ToggleSwitch x:Name="TaskbarToggle" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Run at login" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="Start automatically when you sign in to Windows." FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>
          </StackPanel>
          <ui:ToggleSwitch x:Name="RunOnLoginToggle" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Restart sessions when their CLI updates" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="A deck session running an older version than is installed is resumed on the new one once it has been idle a while and is not the tab in front." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Fg3Brush}"/>
          </StackPanel>
          <ui:ToggleSwitch x:Name="AutoRestartToggle" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Session list order" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="Within each group. Rows never move for recent activity." FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>
          </StackPanel>
          <ComboBox x:Name="RowOrderBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="150">
            <ComboBoxItem Content="State, then name" Tag="State"/>
            <ComboBoxItem Content="Name only" Tag="Name"/>
          </ComboBox>
        </Grid>

        <TextBlock Text="Terminal" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,20,0,0"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
          <ui:TextBox x:Name="FontBox" Grid.Column="0" PlaceholderText="e.g. CaskaydiaCove NF"/>
          <ui:NumberBox x:Name="FontSizeBox" Grid.Column="2" Minimum="8" Maximum="28" SmallChange="1" ClearButtonEnabled="False"
                        SpinButtonPlacementMode="Inline" ToolTip="Font size in points, as in Windows Terminal"/>
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Opacity" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource FgBrush}"/>
          <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
          <TextBlock x:Name="OpacityLabel" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="34" TextAlignment="Right" Foreground="{DynamicResource Fg2Brush}"/>
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Colors" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource FgBrush}"/>
          <ComboBox x:Name="SchemeBox" Grid.Column="1">
            <ComboBoxItem Content="Campbell"/>
            <ComboBoxItem Content="One Half Dark"/>
            <ComboBoxItem Content="Deck"/>
          </ComboBox>
        </Grid>
        <TextBlock Text="Font (size in points), opacity and colors follow Windows Terminal; applied to open tabs on save." FontSize="11.5"
                   Foreground="{DynamicResource Fg3Brush}" Margin="0,4,0,0"/>

        <TextBlock Text="Phone" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,20,0,0"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Session gateway" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="Lets a paired iPhone on this network list sessions and type into them, with the deck window closed too." FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>
          </StackPanel>
          <ui:ToggleSwitch x:Name="GatewayToggle" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Port" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource FgBrush}"/>
          <ui:NumberBox x:Name="GatewayPortBox" Grid.Column="1" Minimum="1024" Maximum="65535" SmallChange="1" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden"/>
          <ui:Button x:Name="FirewallButton" Grid.Column="3" Content="Allow through firewall" Appearance="Secondary" Click="Firewall_Click"
                     ToolTip="Adds a Windows Firewall rule for this port on private networks. Asks for administrator approval once."/>
        </Grid>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image x:Name="QrImage" Grid.Column="0" Width="132" Height="132" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <ui:Button x:Name="PairButton" Content="Show pairing code" Appearance="Secondary" Click="Pair_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="PairText" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="PairNote" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource Fg3Brush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <ItemsControl x:Name="DevicesList" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Seen}" VerticalAlignment="Center" Margin="10,0" FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>
                <ui:Button Grid.Column="2" Content="Revoke" Appearance="Secondary" Tag="{Binding Id}" Click="Revoke_Click"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Claude flags" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,20,0,0"/>
        <TextBlock Text="Appended to every new or resumed Claude session (space-separated)." FontSize="11.5"
                   Foreground="{DynamicResource Fg3Brush}" Margin="0,2,0,6"/>
        <!-- "e.g." matters: a bare flag as placeholder reads as a SAVED value, and users try to edit it. -->
        <ui:TextBox x:Name="ResumeFlagsBox" PlaceholderText="e.g. --dangerously-skip-permissions"/>

        <!-- Separate from the Claude box on purpose: the two CLIs share no flag spelling, so one field
             for both would send codex an argument it exits on. -->
        <TextBlock Text="Codex flags" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,16,0,0"/>
        <TextBlock Text="Appended to every new or resumed Codex session (space-separated)." FontSize="11.5"
                   Foreground="{DynamicResource Fg3Brush}" Margin="0,2,0,6"/>
        <ui:TextBox x:Name="CodexFlagsBox" PlaceholderText="e.g. --dangerously-bypass-approvals-and-sandbox"/>

        <Grid Margin="0,22,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="VersionText" Grid.Column="0" VerticalAlignment="Center" FontSize="11.5"
                     Foreground="{DynamicResource Fg3Brush}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ui:Button Content="Cancel" Appearance="Secondary" Click="Cancel_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Save" Appearance="Primary" Click="Save_Click"/>
          </StackPanel>
        </Grid>
      </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</ui:FluentWindow>
