<ui:FluentWindow x:Class="ClaudeSessionMonitor.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="470" Height="408"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Segoe UI Variable, Segoe UI"
                 FontSize="14">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Settings" Height="36"/>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
      <StackPanel Margin="18,14">
        <TextBlock Text="Resume flags" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
        <TextBlock Text="Appended to every resumed session (space-separated)." FontSize="11.5"
                   Foreground="{DynamicResource Fg3Brush}" Margin="0,2,0,6"/>
        <ui:TextBox x:Name="ResumeFlagsBox" PlaceholderText="--dangerously-skip-permissions"/>

        <TextBlock Text="Context window (tokens)" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource FgBrush}" Margin="0,18,0,0"/>
        <TextBlock Text="Divisor for the Context % column (default 1,000,000)." FontSize="11.5"
                   Foreground="{DynamicResource Fg3Brush}" Margin="0,2,0,6"/>
        <ui:TextBox x:Name="ContextWindowBox" PlaceholderText="1000000"/>

        <TextBlock Text="Instant updates" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource FgBrush}" Margin="0,18,0,0"/>
        <TextBlock Text="Push updates via Claude Code hooks (adds marked hooks to ~/.claude/settings.json; reversible + backed up)."
                   FontSize="11.5" Foreground="{DynamicResource Fg3Brush}" Margin="0,2,0,6" TextWrapping="Wrap"/>
        <CheckBox x:Name="InstantUpdatesCheck" Content="Enable instant updates"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <ui:Button Content="Cancel" Appearance="Secondary" Click="Cancel_Click" Margin="0,0,8,0"/>
          <ui:Button Content="Save" Appearance="Primary" Click="Save_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
