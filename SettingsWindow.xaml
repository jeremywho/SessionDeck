<ui:FluentWindow x:Class="ClaudeSessionMonitor.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="470" Height="366"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Segoe UI Variable, Segoe UI"
                 FontSize="14">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Settings" Height="36"/>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
      <StackPanel Margin="18,14">
        <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Dark theme" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
          <ui:ToggleSwitch x:Name="ThemeToggle" Grid.Column="1"/>
        </Grid>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Show in taskbar" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="Turn off to live in the tray only." FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>
          </StackPanel>
          <ui:ToggleSwitch x:Name="TaskbarToggle" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="Resume flags" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,20,0,0"/>
        <TextBlock Text="Appended to every resumed session (space-separated)." FontSize="11.5"
                   Foreground="{DynamicResource Fg3Brush}" Margin="0,2,0,6"/>
        <ui:TextBox x:Name="ResumeFlagsBox" PlaceholderText="--dangerously-skip-permissions"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <ui:Button Content="Cancel" Appearance="Secondary" Click="Cancel_Click" Margin="0,0,8,0"/>
          <ui:Button Content="Save" Appearance="Primary" Click="Save_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
