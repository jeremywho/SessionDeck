<ui:FluentWindow x:Class="ClaudeSessionMonitor.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="470" Height="412"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Segoe UI Variable, Segoe UI"
                 FontSize="14">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Settings" Height="36"/>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
      <StackPanel Margin="18,14">
        <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Dark theme" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
          <ui:ToggleSwitch x:Name="ThemeToggle" Grid.Column="1"/>
        </Grid>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Show in taskbar" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="Turn off to live in the tray only." FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>
          </StackPanel>
          <ui:ToggleSwitch x:Name="TaskbarToggle" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Run at login" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="Start automatically when you sign in to Windows." FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>
          </StackPanel>
          <ui:ToggleSwitch x:Name="RunOnLoginToggle" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="Claude flags" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,20,0,0"/>
        <TextBlock Text="Appended to every new or resumed Claude session (space-separated)." FontSize="11.5"
                   Foreground="{DynamicResource Fg3Brush}" Margin="0,2,0,6"/>
        <!-- "e.g." matters: a bare flag as placeholder reads as a SAVED value, and users try to edit it. -->
        <ui:TextBox x:Name="ResumeFlagsBox" PlaceholderText="e.g. --dangerously-skip-permissions"/>

        <!-- Separate from the Claude box on purpose: the two CLIs share no flag spelling, so one field
             for both would send codex an argument it exits on. -->
        <TextBlock Text="Codex flags" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" Margin="0,16,0,0"/>
        <TextBlock Text="Appended to every resumed Codex session (space-separated)." FontSize="11.5"
                   Foreground="{DynamicResource Fg3Brush}" Margin="0,2,0,6"/>
        <ui:TextBox x:Name="CodexFlagsBox" PlaceholderText="e.g. --dangerously-bypass-approvals-and-sandbox"/>

        <Grid Margin="0,22,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="VersionText" Grid.Column="0" VerticalAlignment="Center" FontSize="11.5"
                     Foreground="{DynamicResource Fg3Brush}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ui:Button Content="Cancel" Appearance="Secondary" Click="Cancel_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Save" Appearance="Primary" Click="Save_Click"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
