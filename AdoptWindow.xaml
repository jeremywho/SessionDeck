<ui:FluentWindow x:Class="SessionDeck.AdoptWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:SessionDeck"
                 Title="Adopt sessions"
                 Width="560" Height="480"
                 MinWidth="420" MinHeight="280"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Segoe UI Variable, Segoe UI"
                 FontSize="14">
  <ui:FluentWindow.Resources>
    <local:ProviderColorConverter x:Key="ProviderColor"/>
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Adopt sessions" Height="36"/>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
      <DockPanel Margin="18,14">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" FontSize="14"
                   Foreground="{DynamicResource FgBrush}"
                   Text="Sessions running in other terminals on this machine. Adopting one stops it there and resumes the same conversation in a deck tab; anything it is doing right now is interrupted."
                   TextWrapping="Wrap"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <ui:Button Content="Cancel" Appearance="Secondary" Click="Cancel_Click" Margin="0,0,8,0"/>
          <ui:Button Content="Adopt selected" Appearance="Primary" Click="Adopt_Click"/>
        </StackPanel>

        <TextBlock x:Name="EmptyLabel" DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="13" Visibility="Collapsed"
                   Foreground="{DynamicResource Fg3Brush}" Text="Nothing to adopt: every session on this machine is already in the deck."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanAdopt}" Margin="0,5">
                  <StackPanel Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding ProviderGlyph}" FontSize="10" VerticalAlignment="Center"
                                 Margin="0,0,6,0" ToolTip="{Binding ProviderName}"
                                 Foreground="{Binding Provider, Converter={StaticResource ProviderColor}}"/>
                      <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource FgBrush}"/>
                      <TextBlock Text="{Binding Note}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Fg3Brush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
