<ui:FluentWindow x:Class="ClaudeSessionMonitor.NamePromptWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="New session"
                 Width="360" Height="176"
                 MinWidth="360" MinHeight="176"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Segoe UI Variable, Segoe UI"
                 FontSize="14">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="New session" Height="36" ShowMinimize="False" ShowMaximize="False"/>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
      <StackPanel Margin="18,14">
        <TextBlock Text="Session name" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
        <ui:TextBox x:Name="NameBox" Margin="0,8,0,0" PlaceholderText="e.g. fix the login bug"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <ui:Button Content="Cancel" Appearance="Secondary" IsCancel="True" Margin="0,0,8,0"/>
          <ui:Button Content="Launch" Appearance="Primary" IsDefault="True" Click="Launch_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
