<Window x:Class="ClaudeSessionMonitor.LauncherWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Claude Launcher"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable, Segoe UI">
  <!-- drag anywhere on the pill background to reposition; the spot is remembered -->
  <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
          Padding="5,4" MouseLeftButtonDown="Border_MouseLeftButtonDown">
    <StackPanel Orientation="Horizontal">
      <ui:Button x:Name="NewSessionButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="30" Width="36" Padding="0"
                 VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                 Click="NewSessionButton_Click" ToolTip="New Claude session">
        <ui:Button.Icon><ui:SymbolIcon Symbol="Add24"/></ui:Button.Icon>
      </ui:Button>
      <ui:Button x:Name="NewNamedSessionButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="30" Width="36" Padding="0" Margin="2,0,0,0"
                 VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                 Click="NewNamedSessionButton_Click" ToolTip="New named Claude session…">
        <ui:Button.Icon><ui:SymbolIcon Symbol="Rename24"/></ui:Button.Icon>
      </ui:Button>
    </StackPanel>
  </Border>
</Window>
