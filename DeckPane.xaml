<UserControl x:Class="SessionDeck.DeckPane"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource TitlebarBrush}" BorderBrush="{DynamicResource Border2Brush}"
            BorderThickness="0,0,0,1" Padding="6,4">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Tab" CornerRadius="6" Margin="0,0,4,0" Padding="10,4,4,4" Cursor="Hand"
                      Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                      MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseDown="Tab_MouseDown" Tag="{Binding}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Glyph}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,6,0"
                             Foreground="{Binding GlyphBrush}"/>
                  <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" MaxWidth="180"
                             TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgBrush}"/>
                  <TextBlock Text="exited" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                             Foreground="{DynamicResource Fg3Brush}"
                             Visibility="{Binding ExitedVisibility}"/>
                  <ui:Button Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="22" Width="22" Padding="0"
                             Margin="6,0,0,0" Click="CloseTab_Click" Tag="{Binding}" ToolTip="Close tab (host keeps running)">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss12" FontSize="10"/></ui:Button.Icon>
                  </ui:Button>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                  <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Border2Brush}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid x:Name="Body" Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
      <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"
                 FontSize="13" Foreground="{DynamicResource Fg3Brush}" TextAlignment="Center"
                 Text="No session open.&#10;Click a row on the left, or start one with the buttons."/>
    </Grid>
  </Grid>
</UserControl>
