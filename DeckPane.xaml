<UserControl x:Class="SessionDeck.DeckPane"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AllowDrop="True">
  <UserControl.Resources>
    <!-- A 2 px thumb on a bare track that fades in while the mouse is over the strip, like the terminal's. -->
    <Style x:Key="SlimHScrollBar" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="0" MinWidth="0">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="1" Background="{DynamicResource Fg3Brush}" Opacity="0.7"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.6" BeginTime="0:0:0.4"/></Storyboard></BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Horizontal-only scroller whose bar overlays the strip's bottom padding, so nothing moves when it appears. -->
    <Style x:Key="TabScroller" TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"/>
              <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" VerticalAlignment="Bottom" Height="2" MinHeight="0" MinWidth="0" Margin="0,0,0,-5"
                         Style="{StaticResource SlimHScrollBar}"
                         Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                         Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One column's tab strip. The column's DataContext is its DeckGroup. -->
    <DataTemplate x:Key="GroupStripTemplate">
      <Border Background="Transparent" Padding="6,5,6,6" AllowDrop="True" DragOver="Strip_DragOver" Drop="Strip_Drop"
              PreviewMouseWheel="Strip_MouseWheel">
        <DockPanel LastChildFill="True">
          <!-- New session in this column: click for Claude, right-click to choose. Pinned at the right edge, outside the scroller. -->
          <!-- No taller than a tab: this row sets the strip's height, which must stay level with the list header. -->
          <ui:Button DockPanel.Dock="Right" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="26" Height="26" Width="32" Padding="0"
                     Margin="4,0,0,0" VerticalAlignment="Center" Tag="{Binding}" AutomationProperties.AutomationId="NewInGroup"
                     ToolTip="New Claude session here — right-click for another account, Codex or a plain terminal"
                     Click="NewInGroup_Click" PreviewMouseRightButtonUp="NewInGroup_RightClick">
            <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" FontSize="17" Foreground="{DynamicResource Fg2Brush}"/></ui:Button.Icon>
            <ui:Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="New Claude session" Click="NewClaudeMenu_Click" Tag="{Binding}"/>
                <MenuItem Header="New Codex session" Click="NewCodexMenu_Click" Tag="{Binding}"/>
                <MenuItem Header="New terminal" Click="NewShellMenu_Click" Tag="{Binding}"/>
                <Separator/>
                <MenuItem Header="Add spacer column to the left" Click="AddSpacerLeftMenu_Click" Tag="{Binding}"/>
                <MenuItem Header="Add spacer column to the right" Click="AddSpacerMenu_Click" Tag="{Binding}"/>
              </ContextMenu>
            </ui:Button.ContextMenu>
          </ui:Button>
        <ScrollViewer Style="{StaticResource TabScroller}">
          <ItemsControl ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Tab" CornerRadius="6" Margin="0,0,4,0" Padding="10,4,4,4" Cursor="Hand"
                        Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                        MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseMove="Tab_MouseMove"
                        MouseDown="Tab_MouseDown" AllowDrop="True" Drop="Tab_Drop" Tag="{Binding}">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Close tab (session keeps running)" Click="CloseTabMenu_Click" Tag="{Binding}"/>
                      <MenuItem Header="Close other tabs" Click="CloseOthersMenu_Click" Tag="{Binding}"/>
                      <MenuItem Header="Close all tabs" Click="CloseAllMenu_Click" Tag="{Binding}"/>
                      <MenuItem Header="Close &amp; end session" Click="StopMenu_Click" Tag="{Binding}"/>
                      <MenuItem Header="Restart session (resume on the installed CLI)" Click="RestartMenu_Click" Tag="{Binding}"/>
                      <Separator/>
                      <MenuItem Header="Split right" Click="SplitMenu_Click" Tag="{Binding}"/>
                      <MenuItem Header="Add spacer column to the left" Click="AddSpacerLeftMenu_Click" Tag="{Binding}"/>
                      <MenuItem Header="Add spacer column to the right" Click="AddSpacerMenu_Click" Tag="{Binding}"/>
                      <Separator/>
                      <MenuItem Header="Copy session id" Click="CopyIdMenu_Click" Tag="{Binding}"/>
                      <MenuItem Header="Copy folder" Click="CopyCwdMenu_Click" Tag="{Binding}"/>
                    </ContextMenu>
                  </Border.ContextMenu>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{Binding GlyphBrush}"/>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" MaxWidth="180"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgBrush}"
                               ToolTip="{Binding Tooltip}"/>
                    <TextBlock Text="exited" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                               Foreground="{DynamicResource Fg3Brush}"
                               Visibility="{Binding ExitedVisibility}"/>
                    <ui:Button Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="22" Width="22" Padding="0"
                               Margin="6,0,0,0" Click="CloseTab_Click" Tag="{Binding}" ToolTip="Close tab (session keeps running) — middle-click also closes">
                      <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" FontSize="10"/></ui:Button.Icon>
                    </ui:Button>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Border2Brush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsForeground}" Value="True">
                    <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- A spacer column's strip: blank, draggable to another place, a place to drop a tab, a menu to move or remove it. -->
    <DataTemplate x:Key="SpacerStripTemplate">
      <Border Background="Transparent" MinHeight="26" AllowDrop="True" DragOver="Strip_DragOver" Drop="Strip_Drop" Cursor="SizeAll"
              Tag="{Binding}" AutomationProperties.AutomationId="SpacerStrip"
              MouseLeftButtonDown="Spacer_MouseLeftButtonDown" MouseMove="Spacer_MouseMove"
              ToolTip="Spacer column — drag to move it, drop a tab here to use it, right-click to remove it">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Move left" Click="SpacerMoveLeft_Click" Tag="{Binding}"/>
            <MenuItem Header="Move right" Click="SpacerMoveRight_Click" Tag="{Binding}"/>
            <Separator/>
            <MenuItem Header="Remove spacer" Click="SpacerRemove_Click" Tag="{Binding}"/>
          </ContextMenu>
        </Border.ContextMenu>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource TitlebarBrush}" BorderBrush="{DynamicResource Border2Brush}"
            BorderThickness="0,0,0,1">
      <!-- One column per group, widths kept in step with the page's columns. Built in code. -->
      <!-- Inset exactly like the browser below (3 px left, 6 px right) so star columns here and percent columns there share one width. -->
      <Grid x:Name="StripGrid" MinHeight="36" Margin="3,0,6,0" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
    </Border>

    <Grid x:Name="Body" Grid.Row="1"/>
  </Grid>
</UserControl>
