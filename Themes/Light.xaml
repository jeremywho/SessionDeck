<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="PageBrush"         Color="#E7E8EC"/>
  <SolidColorBrush x:Key="SurfaceBrush"      Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Surface2Brush"     Color="#F2F3F5"/>
  <SolidColorBrush x:Key="RowHoverBrush"     Color="#E8F0FC"/>
  <SolidColorBrush x:Key="TitlebarBrush"     Color="#ECEEF0"/>
  <SolidColorBrush x:Key="Border2Brush"      Color="#E3E5E9"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#D2D5DB"/>
  <SolidColorBrush x:Key="FgBrush"           Color="#1A1C1F"/>
  <SolidColorBrush x:Key="Fg2Brush"          Color="#585C64"/>
  <SolidColorBrush x:Key="Fg3Brush"          Color="#888D96"/>
  <SolidColorBrush x:Key="BarBrush"          Color="#9AA0A8"/>
  <SolidColorBrush x:Key="TrackBrush"        Color="#E9EBEE"/>
  <SolidColorBrush x:Key="GreenBrush"        Color="#1F9D57"/>
  <SolidColorBrush x:Key="AmberBrush"        Color="#B9811A"/>
  <SolidColorBrush x:Key="BlueBrush"         Color="#2F7FE0"/>
  <SolidColorBrush x:Key="SlateBrush"        Color="#6C727C"/>
  <SolidColorBrush x:Key="RedBrush"          Color="#CF4B32"/>
  <!-- provider marks: darker than the dark theme's, or they wash out on the near-white track -->
  <SolidColorBrush x:Key="ClaudeMarkBrush"   Color="#B45430"/>
  <SolidColorBrush x:Key="CodexMarkBrush"    Color="#0B7D60"/>
</ResourceDictionary>
