<ui:FluentWindow x:Class="SessionDeck.SessionsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:SessionDeck"
                 Title="Session Deck"
                 Width="1180" Height="720"
                 MinWidth="760" MinHeight="400"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Segoe UI Variable, Segoe UI"
                 FontSize="14">

  <ui:FluentWindow.Resources>
    <local:PctToBrushConverter x:Key="PctToBrush"/>
    <local:DesktopColorConverter x:Key="DesktopColor"/>
    <local:SeverityToBrushConverter x:Key="SeverityToBrush"/>
    <local:PctToStarConverter x:Key="PctToStar"/>
    <local:ProviderColorConverter x:Key="ProviderColor"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Static status glyphs driven by SessionState. Deliberately no WPF animation clocks: even a
         tiny repeating storyboard keeps the WPF/DWM composition path continuously active. -->
    <DataTemplate x:Key="StatusGlyphTemplate">
      <Grid>
        <!-- desktop pip at the far-left edge — only for sessions on another virtual desktop -->
        <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                 Fill="{Binding DesktopIndex, Converter={StaticResource DesktopColor}}"
                 Visibility="{Binding OnOtherDesktop, Converter={StaticResource BoolToVis}}"
                 ToolTip="{Binding DesktopLabel}"/>
        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse x:Name="Dot" Width="18" Height="18"/>
          <TextBlock x:Name="Check" Text="&#x2713;" FontSize="10" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          <TextBlock x:Name="Bang" Text="!" FontSize="11" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          <!-- Vector play mark, optically centered: its centroid is (9,9), the circle's exact center. -->
          <Path x:Name="Run" Width="18" Height="18" Stretch="None" Fill="White"
                Data="M 7,5 L 13,9 L 7,13 Z" Visibility="Collapsed"/>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Completed">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource GreenBrush}"/>
          <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Idle">
          <Setter TargetName="Dot" Property="Fill" Value="Transparent"/>
          <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource SlateBrush}"/>
          <Setter TargetName="Dot" Property="StrokeThickness" Value="2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Awaiting">
          <Setter TargetName="Dot" Property="Fill" Value="Transparent"/>
          <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AmberBrush}"/>
          <Setter TargetName="Dot" Property="StrokeThickness" Value="2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Working">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource BlueBrush}"/>
          <Setter TargetName="Run" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Error">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource RedBrush}"/>
          <Setter TargetName="Bang" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="Hdr" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg3Brush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="HdrRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Hdr}">
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style x:Key="HdrRightInset" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HdrRight}">
      <Setter Property="Padding" Value="0,0,16,6"/>
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Session Deck" Height="36">
      <ui:TitleBar.TrailingContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
          <ui:Button x:Name="UpdateButton" Appearance="Primary" BorderThickness="0" MinHeight="0" MaxHeight="28" Width="34" Padding="0" Margin="0,0,6,0"
                     VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                     Click="UpdateButton_Click" Visibility="Collapsed" ToolTip="Update ready — click to restart">
            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24"/></ui:Button.Icon>
          </ui:Button>
          <ui:Button x:Name="SettingsButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="28" Width="34" Padding="0"
                     VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                     Click="SettingsButton_Click" ToolTip="Settings">
            <ui:Button.Icon><ui:SymbolIcon Symbol="Settings24"/></ui:Button.Icon>
          </ui:Button>
          <ui:Button x:Name="OnTopButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="28" Width="34" Padding="0" Margin="2,0,0,0"
                     VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                     Click="OnTopButton_Click" ToolTip="Keep window always on top"/>
        </StackPanel>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <!-- solid surface for everything below the title bar (legible over Mica) -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ListColumn" Width="460" MinWidth="380"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <local:DeckPane x:Name="Deck" Grid.Column="2"/>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{DynamicResource Border2Brush}" ShowsPreview="False"/>
      <Grid Grid.Column="0">
        <Grid.LayoutTransform>
          <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="SessionsGrid" Grid.Row="0"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                  Background="Transparent" CanUserAddRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                  SelectionMode="Single" RowHeight="46" ColumnHeaderHeight="34"
                  Foreground="{DynamicResource FgBrush}"
                  MouseDoubleClick="Grid_MouseDoubleClick"
                  MouseLeftButtonUp="Grid_MouseLeftButtonUp"
                  PreviewMouseRightButtonUp="Grid_MouseRightButtonUp">
          <DataGrid.CellStyle>
            <Style TargetType="DataGridCell">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            </Style>
          </DataGrid.CellStyle>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}"/>
              <Setter Property="BorderThickness" Value="0,1,0,0"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Background" Value="Transparent"/>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>

          <DataGrid.Columns>
            <!-- curated (always visible) -->
            <DataGridTemplateColumn x:Name="ColGlyph" Width="40" CanUserSort="False"
                                    CellTemplate="{StaticResource StatusGlyphTemplate}"/>

            <DataGridTemplateColumn x:Name="ColSession" Width="*" CanUserResize="False" Header="SESSION" HeaderStyle="{StaticResource Hdr}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,18,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <!-- The subagent badge's slot is reserved whether or not a badge is showing:
                           as a plain Auto column it collapsed to nothing on most rows, which shoved
                           the model pill right and left again as agents came and went. MinWidth (not
                           a fixed Width) so a two-digit count still fits. -->
                      <ColumnDefinition Width="Auto" MinWidth="42"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                      <!-- background-agent badge: a companion thread another app is driving (the
                           Claude Code codex plugin's second opinions). No terminal window exists,
                           so the row announces itself as an agent instead of a session. -->
                      <Border DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Padding="6,1"
                              CornerRadius="8" Background="{DynamicResource TrackBrush}"
                              BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                              Visibility="{Binding IsBackgroundAgent, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="9.5"
                                     Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                          <TextBlock Text="agent" FontSize="10.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding HostedGlyph}" FontSize="9" VerticalAlignment="Center"
                                 Margin="0,0,6,0" Foreground="{DynamicResource BlueBrush}"
                                 Visibility="{Binding IsHosted, Converter={StaticResource BoolToVis}}"
                                 ToolTip="Hosted in this deck"/>
                      <TextBlock Text="{Binding Name}" FontSize="14.5" VerticalAlignment="Center"
                                 Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <!-- model pill: provider mark + model, plus reasoning effort where the CLI reports
                         one (Codex does; Claude Code doesn't put it in the transcript). The provider
                         mark lives IN the pill rather than beside it — one element to read, not two. -->
                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Padding="6,1"
                            CornerRadius="4" Background="{DynamicResource TrackBrush}"
                            BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                            Visibility="{Binding HasModel, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding ModelTooltip}" ToolTipService.InitialShowDelay="250">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProviderGlyph}" FontSize="9.5" VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   Foreground="{Binding Provider, Converter={StaticResource ProviderColor}}"/>
                        <TextBlock Text="{Binding ModelChip}" FontSize="10.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Fg2Brush}"/>
                        <TextBlock Text="{Binding Effort}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Foreground="{DynamicResource Fg3Brush}"
                                   Visibility="{Binding HasEffort, Converter={StaticResource BoolToVis}}"/>
                      </StackPanel>
                    </Border>
                    <!-- live-subagent count: shown only while the session has agents working -->
                    <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="8,0,0,0" Padding="6,1"
                            CornerRadius="8" Background="{DynamicResource BlueBrush}"
                            Visibility="{Binding HasActiveSubagents, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding SubagentTooltip}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" Foreground="White"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding SubagentsActive}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn x:Name="ColCtxPct" Width="80" Header="CONTEXT" HeaderStyle="{StaticResource HdrRight}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ContextDisplay}" FontFamily="Cascadia Mono, Consolas" FontSize="13.5"
                             FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Foreground="{Binding ContextPct, Converter={StaticResource PctToBrush}}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn x:Name="ColIdle" Width="94" Header="IDLE" HeaderStyle="{StaticResource HdrRightInset}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- transparent Border = full-cell hover target for the per-row details tooltip -->
                  <Border Background="Transparent" ToolTip="{Binding RowTooltip}"
                          ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000">
                    <TextBlock Text="{Binding IdleDisplay}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{DynamicResource Fg3Brush}"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- optional extras, hidden by default, toggled via the Columns button -->
            <DataGridTextColumn x:Name="ColStatus" Header="STATUS" Binding="{Binding Status}" Width="90"
                                HeaderStyle="{StaticResource Hdr}" Visibility="Collapsed"/>
            <DataGridTextColumn x:Name="ColPid" Header="PID" Binding="{Binding Pid}" Width="70"
                                HeaderStyle="{StaticResource Hdr}" Visibility="Collapsed"/>
            <DataGridTextColumn x:Name="ColId" Header="ID" Binding="{Binding ShortId}" Width="92"
                                HeaderStyle="{StaticResource Hdr}" Visibility="Collapsed"/>
            <DataGridTextColumn x:Name="ColContextTokens" Header="CTX TOKENS" Binding="{Binding ContextTokensDisplay}" Width="100"
                                HeaderStyle="{StaticResource Hdr}" Visibility="Collapsed"/>
            <DataGridTextColumn x:Name="ColLastTool" Header="LAST TOOL" Binding="{Binding LastTool}" Width="120"
                                HeaderStyle="{StaticResource Hdr}" Visibility="Collapsed"/>
            <DataGridTextColumn x:Name="ColCwd" Header="CWD" Binding="{Binding Cwd}" Width="220"
                                HeaderStyle="{StaticResource Hdr}" Visibility="Collapsed"/>
            <DataGridTextColumn x:Name="ColVersion" Header="VERSION" Binding="{Binding Version}" Width="84"
                                HeaderStyle="{StaticResource Hdr}" Visibility="Collapsed"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- floating new-session buttons over the list's lower-right corner -->
        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12"
                CornerRadius="10" Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Padding="5,4">
          <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/>
          </Border.Effect>
          <!-- One row per CLI, each led by its provider mark so the rows don't need labels. Within a
               row: two groups, divider between — new WINDOW on the left, new TAB in the last-used
               terminal on the right; plain then named within each group.
               The Codex row is SHORTER on purpose: codex has no name argument (it rejects one), because
               a Codex thread is named from inside the TUI once it's running, so the two "named"
               buttons have no Codex equivalent to point at. -->
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <!-- Fixed width, not auto: ✳ and ◆ measure differently, and letting each row's glyph set
                   its own width knocked the two rows ~4px out of alignment with each other. -->
              <TextBlock Text="✳" FontSize="10" Width="12" TextAlignment="Center"
                         VerticalAlignment="Center" Margin="4,0,7,0"
                         ToolTip="Claude Code" Foreground="{DynamicResource ClaudeMarkBrush}"/>
              <ui:Button x:Name="NewSessionButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="30" Width="36" Padding="0"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                         Click="NewSessionButton_Click" ToolTip="New Claude session — in a deck tab">
                <ui:Button.Icon><ui:SymbolIcon Symbol="PanelRightContract20"/></ui:Button.Icon>
              </ui:Button>
              <ui:Button x:Name="NewNamedSessionButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="30" Width="36" Padding="0" Margin="2,0,0,0"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                         Click="NewNamedSessionButton_Click" ToolTip="New named Claude session — in a deck tab…">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Rename24"/></ui:Button.Icon>
              </ui:Button>

              <!-- Carries the whole window-vs-tab distinction (the "named" glyph repeats in both
                   groups), so it has to actually be visible — BorderStrongBrush was not. -->
              <Border Width="1" Margin="7,4,7,4" Opacity="0.55" Background="{DynamicResource Fg3Brush}"/>

              <ui:Button x:Name="NewTabButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="30" Width="36" Padding="0"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                         Click="NewTabButton_Click" ToolTip="New Claude session — external Windows Terminal tab">
                <ui:Button.Icon><ui:SymbolIcon Symbol="TabAdd24"/></ui:Button.Icon>
              </ui:Button>
              <ui:Button x:Name="NewNamedTabButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="30" Width="36" Padding="0" Margin="2,0,0,0"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                         Click="NewNamedTabButton_Click" ToolTip="New named Claude session — external Windows Terminal tab…">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Rename24"/></ui:Button.Icon>
              </ui:Button>
            </StackPanel>

            <Border Height="1" Margin="4,5,4,5" Opacity="0.4" Background="{DynamicResource Fg3Brush}"/>

            <StackPanel Orientation="Horizontal">
              <TextBlock Text="◆" FontSize="10" Width="12" TextAlignment="Center"
                         VerticalAlignment="Center" Margin="4,0,7,0"
                         ToolTip="Codex" Foreground="{DynamicResource CodexMarkBrush}"/>
              <ui:Button x:Name="NewCodexSessionButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="30" Width="36" Padding="0"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                         Click="NewCodexSessionButton_Click" ToolTip="New Codex session — in a deck tab">
                <ui:Button.Icon><ui:SymbolIcon Symbol="PanelRightContract20"/></ui:Button.Icon>
              </ui:Button>

              <!-- Empty stand-in for Claude's "named" button. Not dead markup: it holds the Codex row's
                   divider and tab button in the same columns as the row above, which is the only reason
                   the two rows read as a grid. Its width must track the buttons' (36 + 2 margin). -->
              <Border Width="36" Margin="2,0,0,0" Background="Transparent" IsHitTestVisible="False"/>

              <Border Width="1" Margin="7,4,7,4" Opacity="0.55" Background="{DynamicResource Fg3Brush}"/>

              <ui:Button x:Name="NewCodexTabButton" Appearance="Transparent" BorderThickness="0" MinHeight="0" MaxHeight="30" Width="36" Padding="0"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15"
                         Click="NewCodexTabButton_Click" ToolTip="New Codex session — external Windows Terminal tab">
                <ui:Button.Icon><ui:SymbolIcon Symbol="TabAdd24"/></ui:Button.Icon>
              </ui:Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- footer: live count + color key -->
        <Border Grid.Row="1" Background="{DynamicResource TitlebarBrush}" BorderBrush="{DynamicResource Border2Brush}"
                BorderThickness="0,1,0,0" Padding="18,11">
          <DockPanel LastChildFill="False">
            <TextBlock x:Name="LiveLabel" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11.5"
                       Foreground="{DynamicResource Fg3Brush}" Text="Starting…"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <Grid Width="13" Height="13" VerticalAlignment="Center">
                  <Ellipse Width="13" Height="13" Fill="{DynamicResource RedBrush}"/>
                  <TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Error" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg2Brush}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <Grid Width="13" Height="13" VerticalAlignment="Center">
                  <Ellipse Width="13" Height="13" Fill="{DynamicResource GreenBrush}"/>
                  <TextBlock Text="&#x2713;" Foreground="White" FontSize="8" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Completed" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg2Brush}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <Ellipse Width="13" Height="13" Stroke="{DynamicResource AmberBrush}" StrokeThickness="2"
                         Fill="Transparent" VerticalAlignment="Center"/>
                <TextBlock Text="Awaiting" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg2Brush}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <Ellipse Width="13" Height="13" Stroke="{DynamicResource SlateBrush}" StrokeThickness="2"
                         Fill="Transparent" VerticalAlignment="Center"/>
                <TextBlock Text="Idle" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg2Brush}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Grid Width="13" Height="13" VerticalAlignment="Center">
                  <Ellipse Width="13" Height="13" Fill="{DynamicResource BlueBrush}"/>
                  <!-- Same optically-centered vector at legend scale; centroid is (6.5,6.5). -->
                  <Path Width="13" Height="13" Stretch="None" Fill="White"
                        Data="M 5,4 L 9.5,6.5 L 5,9 Z"/>
                </Grid>
                <TextBlock Text="Working" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg2Brush}"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- account + plan usage, read from ~/.claude.json (not ~/.claude/) — see AccountScanner -->
        <Border x:Name="UsageBar" Grid.Row="2" Background="{DynamicResource TitlebarBrush}"
                BorderBrush="{DynamicResource Border2Brush}" BorderThickness="0,1,0,0" Padding="18,7">
          <!-- The meters are docked FIRST so they always get their width; DockPanel hands space out
               in child order, and with the account label first a long address clipped the last pill. -->
          <DockPanel LastChildFill="False">
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Meters}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border MinWidth="88" Height="21" Margin="7,0,0,0" CornerRadius="10"
                          Background="{DynamicResource TrackBrush}" ToolTip="{Binding Tooltip}"
                          ToolTipService.InitialShowDelay="250">
                    <Grid>
                      <!-- proportional fill. It's a translucent wash rather than a solid severity
                           color so the label on top stays legible in both themes. -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PctToStar}}"/>
                          <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PctToStar}, ConverterParameter=rest}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10" Opacity="0.32"
                                Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="9,0">
                        <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg2Brush}"/>
                        <TextBlock Text="{Binding PercentDisplay}" FontSize="11" FontWeight="SemiBold"
                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=text}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The address trims, the state note does not: at the minimum window width there isn't
                 room for both, and "cached" / "42m old" is the part that changes what you trust. -->
            <Grid x:Name="AccountGroup" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="AccountLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="11.5"
                         Foreground="{DynamicResource Fg3Brush}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="UsageStateLabel" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5"
                         Margin="6,0,0,0" Foreground="{DynamicResource Fg3Brush}"/>
            </Grid>
          </DockPanel>
        </Border>

      </Grid>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
